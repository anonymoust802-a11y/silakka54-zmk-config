#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <170>;
            flavor = "tap-preferred";
        };

        td_minus: td_minus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS";
            #binding-cells = <0>;
            bindings = <&hm F12 MINUS>, <&kp LS(MINUS)>;

            tapping-term-ms = <200>;
        };

        td_apostrophe: td_apostrophe {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_APOSTROPHE";
            #binding-cells = <0>;
            bindings = <&hm_hold LEFT_SHIFT APOS>, <&kp LS(MINUS)>;

            tapping-term-ms = <200>;
        };

        td_semicolon: td_semicolon {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SEMICOLON";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp LS(SEMICOLON)>;

            tapping-term-ms = <200>;
        };

        td_comma: td_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(SEMICOLON)>;

            tapping-term-ms = <200>;
        };

        td_forward_slash: td_forward_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_FORWARD_SLASH";
            #binding-cells = <0>;
            bindings = <&kp SLASH>, <&kp LS(SLASH)>;

            tapping-term-ms = <200>;
        };

        td_period: td_period {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PERIOD";
            #binding-cells = <0>;
            bindings = <&kp PERIOD>, <&kp LS(PERIOD)>;

            tapping-term-ms = <200>;
        };

        hm_hold: hm_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_HOLD";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "hold-preferred";
        };

        td_esc: td_esc {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_ESC";
            #binding-cells = <0>;
            bindings = <&hm GRAVE ESCAPE>, <&kp TILDE>;

            tapping-term-ms = <200>;
        };

        td_equal: td_equal {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_EQUAL";
            #binding-cells = <0>;
            bindings = <&hm F11 EQUAL>, <&kp LS(EQUAL)>;

            tapping-term-ms = <200>;
        };

        lt_kp_tap_ret: lt_kp_tap_ret {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_KP_TAP_RET";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <170>;
            flavor = "tap-preferred";
            retro-tap;
        };

        hm_mkp_hold: hm_mkp_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "HM_MKP_HOLD";
            bindings = <&kp>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "hold-preferred";
        };

        td_l1: td_l1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_L1";
            #binding-cells = <0>;
            bindings = <&lt_kp_tap_ret 1 RIGHT_ARROW>, <&tog 1>;

            tapping-term-ms = <200>;
        };

        td_r1: td_r1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_R1";
            #binding-cells = <0>;
            bindings = <&lt_kp_tap_ret 3 RIGHT_ARROW>, <&tog 3>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <13 14>;
            timeout-ms = <50>;
        };

        cc {
            bindings = <&kp LC(C)>;
            key-positions = <25 26 27>;
        };

        cv {
            bindings = <&kp LC(V)>;
            key-positions = <26 27 28>;
        };

        delete {
            bindings = <&kp DELETE>;
            key-positions = <52 50>;
            timeout-ms = <50>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <52 51>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  n/a   |  |  n/a  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | GUI  | LOWER| SPACE|  n/a   |  |  n/a  | ENTER| RAISE | BSPC  |
            // Note: Silakka54 has 54 keys - the 4 positions marked n/a are not present (inner thumb + encoder positions)

            display-name = "Base";
            bindings = <
&td_esc                           &hm F1 NUMBER_1  &hm F2 NUMBER_2  &hm F3 NUMBER_3               &hm F4 NUMBER_4         &hm F5 NUMBER_5                  &hm F6 NUMBER_6  &hm F7 NUMBER_7             &hm F8 NUMBER_8          &hm F9 NUMBER_9  &hm F10 NUMBER_0   &td_equal
&kp TAB                           &kp Q            &kp W            &kp E                         &kp R                   &kp T                            &kp Y            &kp U                       &kp I                    &hm LS(O) O      &hm LS(P) P        &td_minus
&kp LEFT_SHIFT                    &kp A            &kp S            &kp D                         &kp F                   &kp G                            &kp H            &kp J                       &kp K                    &kp L            &td_semicolon      &td_apostrophe
&hm_hold LEFT_CONTROL LANGUAGE_1  &kp Z            &kp X            &kp C                         &kp V                   &kp B            &none    &none  &hm B N          &kp M                       &td_comma                &td_period       &td_forward_slash  &hm_hold LEFT_CONTROL RIGHT_ALT
                                                                    &hm_hold LEFT_ALT LEFT_ARROW  &lt_kp_tap_ret 2 SPACE  &td_l1           &none    &none  &td_r1           &lt_kp_tap_ret 4 BACKSPACE  &hm_hold LEFT_GUI ENTER
            >;
        };

        L1_quick {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |  n/a   |  |  n/a  |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "Raise";
            bindings = <
&trans  &hm F6 NUMBER_6  &hm F7 NUMBER_7  &hm F8 NUMBER_8     &hm F9 NUMBER_9  &hm F10 NUMBER_0                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp Y            &kp U            &kp I               &kp O            &kp P                             &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp H            &kp J            &kp K               &kp L            &kp SEMICOLON                     &trans  &trans  &trans  &trans  &trans  &trans
&trans  &kp N            &kp M            &kp COMMA           &kp PERIOD       &kp COMMA         &none    &none  &trans  &trans  &trans  &trans  &trans  &trans
                                          &hm LEFT_ALT ENTER  &kp BACKSPACE    &trans            &none    &none  &trans  &trans  &trans
            >;
        };

        L2_slow {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | USB  | BLE   |       |      |       |BTCLRALL|
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |  n/a   |  |  n/a  |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "Lower";
            bindings = <
&trans  &kp F13  &kp F14         &kp F15         &kp F16          &kp F17                                &trans  &trans  &trans                       &trans                         &trans         &trans
&trans  &kp F18  &kp F19         &kp UP_ARROW    &kp F20          &hm_hold HOME PAGE_UP                  &trans  &trans  &trans                       &trans                         &trans         &trans
&trans  &trans   &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &hm END PAGE_DOWN                      &trans  &trans  &trans                       &trans                         &trans         &trans
&trans  &trans   &trans          &trans          &trans           &trans                 &none    &none  &trans  &trans  &hm LEFT_BRACKET LEFT_BRACE  &hm RIGHT_BRACKET RIGHT_BRACE  &kp BACKSLASH  &trans
                                 &trans          &trans           &trans                 &none    &none  &trans  &trans  &trans
            >;
        };

        R1_quick {
            bindings = <
&trans  &trans  &trans          &trans          &trans           &trans                               &trans    &trans          &trans          &trans           &trans     &trans
&trans  &trans  &trans          &kp UP_ARROW    &trans           &hm HOME PAGE_UP                     &mkp MB4  &trans          &mmv MOVE_UP    &trans           &trans     &trans
&trans  &trans  &kt LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &hm END PAGE_DOWN                    &mkp MB5  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp LCLK  &msc SCRL_UP
&trans  &trans  &trans          &trans          &trans           &trans             &trans    &trans  &trans    &msc SCRL_LEFT  &mkp MB3        &msc SCRL_RIGHT  &mkp RCLK  &msc SCRL_DOWN
                                &trans          &trans           &trans             &trans    &trans  &trans    &trans          &trans
            >;
        };

        R2_slow {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans        &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans        &trans        &trans        &trans
                        &trans  &trans  &trans  &trans    &trans  &trans        &trans        &trans
            >;
        };
    };
};
