#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "homerow";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
        };

        lt_custom: lt {
            compatible = "zmk,behavior-hold-tap";
            label = "layer";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <220>;
            quick-tap-ms = <170>;
            flavor = "tap-preferred";
            retro-tap;
        };

        lt_custom2: lt_custom2 {
            compatible = "zmk,behavior-hold-tap";
            label = "LT_CUSTOM2";
            bindings = <&mo>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <130>;
            flavor = "tap-preferred";
            retro-tap;
        };

        td_language: td_language {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_LANGUAGE";
            #binding-cells = <0>;
            bindings = <&hm LEFT_CONTROL LANGUAGE_1>, <&kp LANGUAGE_2>;

            tapping-term-ms = <350>;
        };

        td_1: td_1 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_1";
            #binding-cells = <0>;
            bindings = <&hm F1 NUMBER_1>, <&kp NUMBER_6>, <&kp EXCLAMATION>;

            tapping-term-ms = <170>;
        };

        td_2: td_2 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_2";
            #binding-cells = <0>;
            bindings = <&hm F2 NUMBER_2>, <&kp NUMBER_7>, <&kp AT_SIGN>;

            tapping-term-ms = <170>;
        };

        td_3: td_3 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_3";
            #binding-cells = <0>;
            bindings = <&hm F3 NUMBER_3>, <&kp NUMBER_8>, <&kp HASH>;

            tapping-term-ms = <170>;
        };

        td_4: td_4 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_4";
            #binding-cells = <0>;
            bindings = <&hm F4 NUMBER_4>, <&kp NUMBER_9>, <&kp DOLLAR>;

            tapping-term-ms = <170>;
        };

        td_5: td_5 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_5";
            #binding-cells = <0>;
            bindings = <&hm F5 NUMBER_5>, <&kp NUMBER_0>, <&kp PERCENT>;

            tapping-term-ms = <170>;
        };

        td_r: td_r {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_R";
            #binding-cells = <0>;
            bindings = <&hm R LC(F9)>, <&kp LS(R)>;

            tapping-term-ms = <170>;
        };

        td_e: td_e {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_E";
            #binding-cells = <0>;
            bindings = <&hm E F8>, <&kp LS(E)>;

            tapping-term-ms = <170>;
        };

        td_q: td_q {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Q";
            #binding-cells = <0>;
            bindings = <&hm Q F6>, <&kp LS(E)>;

            tapping-term-ms = <170>;
        };

        td_t: td_t {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_T";
            #binding-cells = <0>;
            bindings = <&hm T F10>, <&kp LS(T)>;

            tapping-term-ms = <170>;
        };

        td_w: td_w {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_W";
            #binding-cells = <0>;
            bindings = <&hm W F7>, <&kp LS(W)>;

            tapping-term-ms = <170>;
        };

        td_n: td_n {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_N";
            #binding-cells = <0>;
            bindings = <&kp N>, <&kp LS(N)>;

            tapping-term-ms = <170>;
        };

        td_minus: td_minus {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_MINUS";
            #binding-cells = <0>;
            bindings = <&kp MINUS>, <&kp LS(MINUS)>;

            tapping-term-ms = <170>;
        };

        td_apostrophe: td_apostrophe {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_APOSTROPHE";
            #binding-cells = <0>;
            bindings = <&kp SQT>, <&kp LS(MINUS)>;

            tapping-term-ms = <170>;
        };

        td_semicolon: td_semicolon {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_SEMICOLON";
            #binding-cells = <0>;
            bindings = <&kp SEMICOLON>, <&kp LS(SEMICOLON)>;

            tapping-term-ms = <170>;
        };

        td_comma: td_comma {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_COMMA";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(SEMICOLON)>;

            tapping-term-ms = <170>;
        };

        td_forward_slash: td_forward_slash {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_FORWARD_SLASH";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(SLASH)>;

            tapping-term-ms = <170>;
        };

        td_period: td_period {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_PERIOD";
            #binding-cells = <0>;
            bindings = <&kp COMMA>, <&kp LS(PERIOD)>;

            tapping-term-ms = <170>;
        };

        td_6: td_6 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_6";
            #binding-cells = <0>;
            bindings = <&hm F6 NUMBER_1>, <&kp NUMBER_1>, <&kp CARET>;

            tapping-term-ms = <170>;
        };

        td_7: td_7 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_7";
            #binding-cells = <0>;
            bindings = <&hm F7 NUMBER_7>, <&kp NUMBER_1>, <&kp AMPERSAND>;

            tapping-term-ms = <170>;
        };

        td_8: td_8 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_8";
            #binding-cells = <0>;
            bindings = <&hm F8 NUMBER_8>, <&kp NUMBER_3>, <&kp HASH>;

            tapping-term-ms = <170>;
        };

        td_9: td_9 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_9";
            #binding-cells = <0>;
            bindings = <&hm F9 NUMBER_9>, <&kp NUMBER_4>, <&kp DOLLAR>;

            tapping-term-ms = <170>;
        };

        td_0: td_0 {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_0";
            #binding-cells = <0>;
            bindings = <&hm F10 NUMBER_0>, <&kp NUMBER_5>, <&kp PERCENT>;

            tapping-term-ms = <170>;
        };

        td_a: td_a {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_A";
            #binding-cells = <0>;
            bindings = <&hm F11 A>, <&kp LC(A)>;

            tapping-term-ms = <170>;
        };

        td_s: td_s {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_S";
            #binding-cells = <0>;
            bindings = <&hm F12 S>, <&kp LC(S)>;

            tapping-term-ms = <170>;
        };

        td_d: td_d {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_D";
            #binding-cells = <0>;
            bindings = <&hm F13 D>, <&kp LC(D)>;

            tapping-term-ms = <170>;
        };

        td_f: td_f {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_F";
            #binding-cells = <0>;
            bindings = <&hm F14 F>, <&kp LC(F)>;

            tapping-term-ms = <170>;
        };

        td_g: td_g {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_G";
            #binding-cells = <0>;
            bindings = <&hm F15 G>, <&kp LC(G)>;

            tapping-term-ms = <170>;
        };

        td_z: td_z {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_Z";
            #binding-cells = <0>;
            bindings = <&hm F16 Z>, <&kp LC(Z)>;

            tapping-term-ms = <170>;
        };

        td_x: td_x {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_X";
            #binding-cells = <0>;
            bindings = <&hm F17 X>, <&kp LC(X)>;

            tapping-term-ms = <170>;
        };

        td_c: td_c {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_C";
            #binding-cells = <0>;
            bindings = <&hm F18 C>, <&kp LC(C)>;

            tapping-term-ms = <170>;
        };

        td_v: td_v {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_V";
            #binding-cells = <0>;
            bindings = <&hm F19 V>, <&kp LC(V)>;

            tapping-term-ms = <170>;
        };

        td_b: td_b {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_B";
            #binding-cells = <0>;
            bindings = <&hm F20 B>, <&kp LC(B)>;

            tapping-term-ms = <170>;
        };

        td_o: td_o {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_O";
            #binding-cells = <0>;
            bindings = <&hm LC(O) O>, <&kp LS(B)>;

            tapping-term-ms = <170>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // ------------------------------------------------------------------------------------------------------------
            // |  ESC  |  1  |  2  |  3   |  4   |  5   |                   |  6   |  7    |  8    |  9   |   0   |   `   |
            // |  TAB  |  Q  |  W  |  E   |  R   |  T   |                   |  Y   |  U    |  I    |  O   |   P   |   -   |
            // |  CTRL |  A  |  S  |  D   |  F   |  G   |                   |  H   |  J    |  K    |  L   |   ;   |   '   |
            // | SHIFT |  Z  |  X  |  C   |  V   |  B   |  n/a   |  |  n/a  |  N   |  M    |  ,    |  .   |   /   | SHIFT |
            //                     | GUI  | LOWER| SPACE|  n/a   |  |  n/a  | ENTER| RAISE | BSPC  |
            // Note: Silakka54 has 54 keys - the 4 positions marked n/a are not present (inner thumb + encoder positions)

            display-name = "Base";
            bindings = <
&hm LEFT_GUI ESC  &td_1  &td_2  &td_3         &td_4               &td_5                               &td_6               &td_7                   &td_8         &td_9    &td_0     &kp GRAVE
&kp TAB           &td_q  &td_w  &td_e         &td_r               &td_t                               &kp Y               &kp U                   &kp I         &kp O    &kp P     &kp MINUS
&kp LEFT_SHIFT    &td_a  &td_s  &td_d         &td_f               &td_g                               &kp H               &kp J                   &kp K         &kp L    &kp SEMI  &kp SQT
&kp LEFT_CONTROL  &td_z  &td_x  &td_c         &td_v               &td_b               &none    &none  &td_n               &kp M                   &kp COMMA     &kp DOT  &kp FSLH  &td_language
                                &kp LEFT_ALT  &lt_custom 1 SPACE  &lt_custom2 2 LCLK  &none    &none  &lt_custom 4 ENTER  &lt_custom 3 BACKSPACE  &kp LEFT_GUI
            >;
        };

        L1 {
            // ------------------------------------------------------------------------------------------------------------
            // | BTCLR | BT1 | BT2 |  BT3 |  BT4 |  BT5 |                   | USB  | BLE   |       |      |       |BTCLRALL|
            // |  F1   |  F2 |  F3 |  F4  |  F5  |  F6  |                   |  F7  |  F8   |  F9   |  F10 |  F11  |  F12  |
            // |   `   |  !  |  @  |  #   |  $   |  %   |                   |  ^   |  &    |  *    |  (   |   )   |   ~   |
            // |       |     |     |      |      |      |  n/a   |  |  n/a  |      |  _    |  +    |  {   |   }   |  "|"  |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "Lower";
            bindings = <
&bt BT_SEL 0  &kp F1   &kp F2   &kp F3       &kp F4         &kp F5                         &out OUT_USB  &out OUT_BLE  &trans           &trans    &trans    &bt BT_CLR_ALL
&bt BT_SEL 1  &kp F6   &kp F7   &kp F8       &kp F9         &kp F10                        &kp F7        &kp F8        &kp F9           &kp F10   &kp F11   &kp F12
&bt BT_SEL 2  &kp F11  &kp F12  &kp PAGE_UP  &kp UP         &kp PAGE_DOWN                  &kp CARET     &kp AMPS      &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp TILDE
&bt BT_SEL 3  &trans   &trans   &kp LEFT     &kp DOWN       &kp RIGHT      &none    &none  &trans        &kp MINUS     &kp KP_PLUS      &kp LBRC  &kp RBRC  &kp PIPE
                                &kp DELETE   &kp BACKSPACE  &trans         &none    &none  &trans        &trans        &trans
            >;
        };

        L2 {
            // ------------------------------------------------------------------------------------------------------------
            // |       |     |     |      |      |      |                   |      |       |       |      |       |       |
            // |   `   |  1  |  2  |  3   |  4   |  5   |                   |  6   |   7   |   8   |  9   |   0   |       |
            // |   F1  |  F2 |  F3 |  F4  |  F5  |  F6  |                   |      |   <-  |   v   |  ^   |  ->   |       |
            // |   F7  |  F8 |  F9 |  F10 |  F11 |  F12 |  n/a   |  |  n/a  |  +   |   -   |   =   |  [   |   ]   |   \   |
            //                     |      |      |      |  n/a   |  |  n/a  |      |       |       |

            display-name = "Raise";
            bindings = <
&td_6  &td_7  &td_8      &td_9       &td_0          &kp GRAVE                     &trans       &trans     &trans     &trans    &trans     &trans
&kp Y  &kp U  &kp I      &kp O       &kp P          &kp MINUS                     &kp N6       &kp N7     &kp N8     &kp N9    &kp N0     &trans
&kp H  &kp J  &kp K      &kp L       &kp SEMICOLON  &kp SQT                       &trans       &kp LEFT   &kp DOWN   &kp UP    &kp RIGHT  &trans
&kp N  &kp M  &kp COMMA  &kp PERIOD  &kp SLASH      &td_language  &none    &none  &kp KP_PLUS  &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT   &kp BSLH
                         &kp DELETE  &kp BACKSPACE  &trans        &none    &none  &trans       &trans     &trans
            >;
        };

        R1 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans        &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans    &kp UP_ARROW  &trans     &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &kp LEFT  &kp DOWN      &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans        &trans     &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans    &trans
            >;
        };

        R2 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans          &trans          &trans           &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK        &trans          &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP    &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB4        &mkp MB3        &mkp MB5         &msc SCRL_DOWN  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans          &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
                        &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans
            >;
        };
    };
};
